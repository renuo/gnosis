#!/bin/bash

source "$(dirname "${BASH_SOURCE[0]}")/support/redmine_env"
ensure_redmine
cd "$REDMINE_ROOT" || exit 1

white='\033[1;37m'
red='\033[0;31m'
green='\033[0;32m'

if bundle exec rake redmine:plugins:test NAME=gnosis; then
  echo -n -e ${green}
  echo "----------------------------------------"
  echo "Tests passed"
  echo "----------------------------------------"
  echo -n -e ${white}
else
  echo -n -e ${red}
  echo "----------------------------------------"
  echo "Tests failed"
  echo "----------------------------------------"
  echo -n -e ${white}
  exit 1
fi
